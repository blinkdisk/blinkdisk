---
import { blogService, directusUrl } from "@marketing/blog/runtime";
import type { PreparedPost } from "@marketing/blog/service";
import Article from "@marketing/components/blog/Article.astro";
import DefaultLayout from "@marketing/layouts/DefaultLayout.astro";
import * as Sentry from "@sentry/astro";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");
let article: PreparedPost | null = null;
let unavailable = false;
try {
  article = await blogService().post(Astro.params.slug ?? "");
} catch (error) {
  unavailable = true;
  console.error("Unable to load blog content", error);
  Sentry.captureException(error);
}
if (!article) Astro.response.status = unavailable ? 503 : 404;
if (unavailable) Astro.response.headers.set("Retry-After", "60");
---
{article ? <Article article={article} cmsUrl={directusUrl()} /> : <DefaultLayout title={unavailable ? "Blog temporarily unavailable" : "Post not found"}><section class="pt-page pb-page w-content mx-auto"><h1>{unavailable ? "The blog is temporarily unavailable" : "Post not found"}</h1><p>{unavailable ? "Please try again shortly." : "This post is not available."}</p><a href="/blog">Back to the blog</a></section></DefaultLayout>}
