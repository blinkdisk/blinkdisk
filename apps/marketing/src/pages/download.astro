---
import DownloadClient from "@marketing/components/react/DownloadClient";
import DefaultLayout from "@marketing/layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="Download"
  description="Download BlinkDisk for Windows, macOS, and Linux."
>
