{
  "name": "blinkdisk",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -- turbo run dev",
    "format": "biome format --write .",
    "env:update": "turbo run env:update",
    "db:migrate:dev": "dotenv -- pnpm --filter db migrate:dev",
    "db:migrate:prod": "dotenv -- pnpm --filter db migrate:prod",
    "db:studio": "dotenv -- pnpm --filter db studio",
    "emails:studio": "dotenv -- pnpm --filter emails studio",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "unused": "knip",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "dotenv-cli": "catalog:",
    "knip": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.15.0"
  }
}
